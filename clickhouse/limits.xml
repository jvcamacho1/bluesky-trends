<?xml version="1.0"?>
<clickhouse>
  <!-- O container tem 1 GB de limite. O ClickHouse fica com 700 MB de uso de
       servidor e deixa o resto para o sistema de arquivos e o cache do SO.
       max_server_memory_usage precisa ficar abaixo do limite do container,
       como pede a regra de orcamento da VPS compartilhada. -->
  <max_server_memory_usage>734003200</max_server_memory_usage>
  <max_server_memory_usage_to_ram_ratio>0.5</max_server_memory_usage_to_ram_ratio>
  <mark_cache_size>134217728</mark_cache_size>
  <uncompressed_cache_size>0</uncompressed_cache_size>
  <logger>
    <level>warning</level>
  </logger>

  <!-- Os logs de sistema (metric_log, query_log, trace_log) foram os primeiros a
       estourar o limite de memoria: o proprio metric_log tentou ler 517 MB para
       compactar. Num projeto deste tamanho eles nao servem para nada, entao ficam
       desligados e a memoria vai para os dados. -->
  <query_log remove="1"/>
  <query_thread_log remove="1"/>
  <trace_log remove="1"/>
  <metric_log remove="1"/>
  <asynchronous_metric_log remove="1"/>
  <part_log remove="1"/>
  <text_log remove="1"/>
  <crash_log remove="1"/>
</clickhouse>
