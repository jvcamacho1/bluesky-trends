# Copie para .env e ajuste. Nenhum valor aqui e segredo: o Jetstream e publico.
INPUT_MODE=ws
JETSTREAM_URL=wss://jetstream.us-east.bsky.network/xrpc/network.bsky.jetstream.subscribeEvents
LANG_PRIMARY_SUBTAGS=["pt"]
CURSOR_PATH=/data/cursor.json
CURSOR_RESUME=true

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=bluesky.posts.pt.v1
KAFKA_DLQ_TOPIC=bluesky.posts.pt.dlq.v1

SCHEMA_REGISTRY_URL=http://localhost:8081
SCHEMA_SUBJECT=bluesky.posts.pt.v1-value
